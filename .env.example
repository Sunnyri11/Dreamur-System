# Variables de entorno (ASP.NET usa "__" como separador de secciones). Copia a tu panel de Render o a user-secrets.

# --- Neon (elige UNA forma) ---
DATABASE_URL=postgresql://neondb_owner:TU_PASSWORD@ep-TU-ENDPOINT-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# ConnectionStrings__Default=Host=ep-xxx-pooler.us-east-2.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=...;SSL Mode=Require

# --- JWT (4 horas = 240 min) ---
Jwt__Key=genera-una-clave-aleatoria-de-64-caracteres-o-mas
Jwt__ExpiraMinutos=240
Jwt__Issuer=DreamurDetector.Api
Jwt__Audience=DreamurDetector.Clients

# --- Frontend ---
# CORS es público por defecto (cualquier página puede llamar a la API). Solo si quieres restringirlo:
# Cors__Restringir=true
# Cors__Origins=https://tu-frontend.onrender.com,https://otro.com
App__FrontendUrl=https://tu-frontend.onrender.com
App__PublicApiUrl=https://dreamur-detector-api.onrender.com

# --- Administrador inicial (se crea una sola vez si no existe ningún admin) ---
Seed__AdminCorreo=admin@tu-dominio.com
Seed__AdminPassword=CambiaEstaClave123

# --- Almacenamiento de imágenes (R2 / S3) ---
Storage__Provider=S3
Storage__ServiceUrl=https://<account>.r2.cloudflarestorage.com
Storage__AccessKey=
Storage__SecretKey=
Storage__Bucket=dreamur
Storage__Region=auto

# --- Servicio ML (Dreamur-Detector en Oracle Cloud) ---
Detector__BaseUrl=http://IP_PUBLICA_ORACLE:8001
Detector__ApiKey=
Detector__CallbackApiKey=

# --- Correo: Brevo (confirmación de cuenta) ---
# Se usa la API HTTPS de Brevo porque Render gratis bloquea los puertos SMTP.
Email__BrevoApiKey=xkeysib-TU_API_KEY
# El remitente debe estar verificado en Brevo.
Email__Remitente=no-reply@tu-dominio.com
Email__RemitenteNombre=Dreamur-Detector
# false = el paciente entra sin confirmar el correo.
Auth__RequerirCorreoVerificado=true
